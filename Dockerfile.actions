FROM rasa/rasa-sdk:3.6.2

WORKDIR /app
COPY . .

# Install extra dependencies as root to avoid permission errors
USER root
RUN if [ -f /app/requirements.txt ]; then pip install --no-cache-dir -r /app/requirements.txt; fi
USER 1001

ENV PORT=5055
EXPOSE 5055

CMD ["start", "--port==${PORT}", "-i 0.0.0.0"]